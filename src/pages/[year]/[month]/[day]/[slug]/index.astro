---
import { render } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import PostMeta from "../../../../../components/PostMeta.astro";
import { getAllPosts, permalinkParts, type BlogPost } from "../../../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: permalinkParts(post),
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article itemscope itemtype="http://schema.org/Article" class="post-block" lang="zh-CN">
    <link itemprop="mainEntityOfPage" href={post.data.permalink} />
    <header class="post-header">
      <h1 class="post-title" itemprop="name headline">{post.data.title}</h1>
      <PostMeta post={post} />
    </header>
    <div class="post-body" itemprop="articleBody">
      <Content />
    </div>
  </article>
</BaseLayout>
